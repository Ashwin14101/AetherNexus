# ─── AetherNexus environment template ────────────────────────────────────────
# Copy to .env and fill in values. Everything below is optional for local dev:
# with no MONGODB_URI the server runs a fully-functional in-memory fallback.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=4000
# MongoDB Atlas connection string (falls back to in-memory store if unset/down)
MONGODB_URI=

# ── Cluster microservices (region node URLs) ──────────────────────────────────
US_EAST_URL=http://localhost:3001
EU_WEST_URL=http://localhost:3002
AP_SOUTH_URL=http://localhost:3004

# ── CORS / auth ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins for production (empty = reflect request origin)
ALLOWED_ORIGINS=
# Bearer token required on chaos endpoints in production (empty = open, dev only)
CHAOS_API_TOKEN=

# ── AI orchestrator (key pool — any one key is enough) ────────────────────────
# Works with OpenAI (sk-…), Groq (gsk_…), or any OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_API_KEY2=
OPENAI_API_KEY3=
# Override base URL for the OpenAI-compatible gateway (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=
# Optional OpenRouter fallback (requires OPENROUTER_API_KEY)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Model the orchestrator requests (provider-specific)
AETHERNEXUS_ORCHESTRATOR_MODEL=
# AI evaluation cadence in ms (default 30000)
AETHERNEXUS_POLLING_INTERVAL_MS=

# ── Orchestrator / alerts ─────────────────────────────────────────────────────
# Public URL of this service (used in alert payloads + orchestrator callbacks)
AETHERNEXUS_GATEWAY_URL=http://localhost:4000
# Slack/Discord incoming webhook for CRITICAL_RED alerts
SLACK_WEBHOOK_URL=

# ── Frontend build-time only (npm --prefix dashboard run build) ───────────────
# Leave empty in production: the dashboard defaults to same-origin API/WS.
# Only set for dev against a backend on another host.
VITE_API_GATEWAY_URL=
