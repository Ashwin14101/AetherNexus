{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "allowJs": false,
    "declaration": true,
    "paths": {}
  },
  "include": ["loadbalancer.ts", "server.ts", "gateway.ts", "nodes/*.ts"]
}
